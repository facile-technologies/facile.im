{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", ".next/**", "!.next/cache/**"],
      "env": ["VITE_API_BASE_URL", "VITE_APP_URL"]
    },
    "lint": {}
  }
}
