# ---- Facile dashboard (Vite) environment ----
# These are BUILD-TIME public values (Vite inlines VITE_* at build). No secrets here.

# backend API base (nginx serves it at /api)
VITE_API_BASE_URL=https://facile.im/api

# app root URL (used for Stripe billing success/cancel redirects) — dashboard lives under /app
VITE_APP_URL=https://facile.im/app

# landing site origin (the auth "back" button returns here). Prod serves landing
# same-domain at "/", so this can be left unset in prod. For local dev, point it
# at the landing dev server. Optional.
VITE_LANDING_URL=/
