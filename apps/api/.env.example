# ---- Facile backend (api) environment ----
# Copy to .env and fill with REAL values on the server. NEVER commit the real .env.

# server
PORT=4000
NODE_ENV=production
DEBUG_MODE=false

# database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# auth / tokens
ACCESS_TOKEN_SECRET=
FORGET_RESET_TOKEN_SECRET=

# urls (set per environment: https + real domain)
SERVER_URL=https://facile.im/api
FRONTEND_URL=https://facile.im
APP_NAME=Facile

# email (SMTP)
MAIL_USER=
MAIL_PASS=

# stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_WEBHOOK_SECRET=
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=
PLATFORM_FEE_PERCENT=10
